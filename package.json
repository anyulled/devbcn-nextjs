{
  "name": "devbcn",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "portless run next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:scss": "stylelint '**/*.scss' --cache",
    "test": "jest",
    "test:coverage": "jest --coverage --coverageReporters=text --coverageReporters=lcov",
    "test:mutation": "stryker run",
    "test:fuzz": "jest __tests__/fuzz",
    "test:snapshots": "jest __tests__/snapshots",
    "test:property": "jest __tests__/property",
    "sass": "sass --watch public/assets/scss/main.scss:public/assets/css/main.css",
    "type-check": "tsc --noEmit && npm run type-check:worker",
    "type-check:worker": "tsc --project tsconfig.worker.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "e2e": "start-server-and-test dev http://localhost:3000 cypress:open",
    "e2e:run": "start-server-and-test start http://localhost:3000 cypress:run",
    "build:docs": "typedoc",
    "check:docs": "bash -c 'echo \"Checking docs sync...\" && ([ -f AGENTS.md ] && [ -f CLAUDE.md ] || cp AGENTS.md CLAUDE.md)'",
    "migrate": "tsx scripts/migrate-sponsors.ts",
    "migrate:logos": "tsx scripts/migrate-logos-to-storage.ts",
    "generate:ama-mentoring": "python3 scripts/generate-ama-mentoring-schedule.py"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@uiw/react-md-editor": "^4.1.1",
    "add-to-calendar-button-react": "^2.15.0",
    "aos": "^2.3.4",
    "baseline-browser-mapping": "^2.10.43",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "react": "^19.2.0",
    "react-countup": "^6.5.3",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.82.0",
    "react-modal-video": "^2.0.2",
    "react-slick": "^0.31.0",
    "sass": "^1.101.0",
    "slick-carousel": "^1.8.1",
    "swiper": "^12.2.0",
    "wowjs": "^1.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.0.2",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.3.0",
    "@jazzer.js/core": "^4.0.0",
    "@jazzer.js/jest-runner": "^4.0.0",
    "@next/eslint-plugin-next": "^16.2.10",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/aos": "^3.0.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@types/react-modal-video": "^1.2.3",
    "@types/react-slick": "^0.23.13",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.59.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "cypress": "^15.18.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "eslint-config-next": "^16.2.10",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-security": "^4.0.1",
    "fast-check": "^4.9.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.1.0",
    "portless": "^0.15.4",
    "prettier": "^3.9.5",
    "schema-dts": "^2.0.0",
    "start-server-and-test": "^3.0.11",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-max-lines": "^0.1.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "whatwg-fetch": "^3.6.20"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix --cache"
    ],
    "*.scss": [
      "stylelint --fix --cache",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "serialize-javascript": "^7.0.3",
    "axios": "^1.13.6",
    "qs": "^6.15.0",
    "minimatch": "^10.0.1",
    "test-exclude": {
      "minimatch": "^3.0.4"
    },
    "glob": {
      "minimatch": "^3.0.4"
    },
    "systeminformation": "^5.31.6"
  }
}
