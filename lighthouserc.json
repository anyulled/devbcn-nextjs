{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start",
      "startServerReadyPattern": "Ready",
      "startServerReadyTimeout": 60000,
      "url": ["http://localhost:3000/"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.94 }],
        "categories:best-practices": ["error", { "minScore": 0.92 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 1000 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 1000 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.03 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 60 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
